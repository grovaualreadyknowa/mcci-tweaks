{
  "schemaVersion": 1,
  "id": "mcci_tweaks",
  "version": "${version}",
  "name": "MCCI Tweaks",
  "description": "Client-side quality of life mod for MCC Island",
  "icon": "assets/mcci_tweaks/icon.png",
  "authors": [
    "Blueberry060"
  ],
  "contact": {
    "homepage": "https://github.com/grovaualreadyknowa/mcci-tweaks",
    "sources": "https://github.com/grovaualreadyknowa/mcci-tweaks",
    "issues": "https://github.com/grovaualreadyknowa/mcci-tweaks/issues"
  },
  "license": "MIT",
  "environment": "client",
  "entrypoints": {
    "main": [
      "dev.caden.mccitweaks.McciTweaksMod"
    ],
    "client": [
      "dev.caden.mccitweaks.McciTweaksClient"
    ],
    "modmenu": [
      "dev.caden.mccitweaks.McciTweaksModMenu"
    ]
  },
  "mixins": [
    "mcci_tweaks.automation.mixins.json",
    "mcci_tweaks.no_flash.mixins.json",
    "mcci_tweaks.material_market.mixins.json",
    "mcci_tweaks.chat.mixins.json"
  ],
  "depends": {
    "minecraft": "26.3",
    "java": ">=25",
    "fabricloader": ">=0.20.1",
    "fabric-api": "*",
    "fabric-language-kotlin": ">=${fabric_kotlin_version}"
  },
  "suggests": {
    "modmenu": "*"
  },
  "breaks": {
    "fishtance": "*",
    "mcc_no_flash": "*",
    "chatsep": "*"
  }
}
